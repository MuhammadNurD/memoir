# Brand Configuration
VITE_BRAND_NAME=Memoir
APP_BASE_URL=http://localhost:5173

# Session & Cookie Security
# Generate a strong secret using: openssl rand -hex 32
AUTH_SESSION_SECRET=local-dev-change-in-production-secret-key-min-32-chars

# Google OAuth 2.0 / OpenID Connect
# Redirect URI (Local): http://localhost:5173/api/auth/callback/google
# Redirect URI (Prod):  https://your-site.netlify.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign In (OAuth 2.0 / OIDC)
# Redirect URI (Local): http://localhost:5173/api/auth/callback/apple
# Redirect URI (Prod):  https://your-site.netlify.app/api/auth/callback/apple
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Transcription Providers
# Options: openai | deepgram | gemini | auto
TRANSCRIPTION_PROVIDER=auto
DEEPGRAM_API_KEY=

# AI Summarization Providers (Netlify AI Gateway auto-injects OPENAI_API_KEY / GEMINI_API_KEY in production)
# Leave empty on Netlify if using Netlify AI Gateway, or provide keys for direct local calls
AI_SUMMARY_PROVIDER=auto
OPENAI_API_KEY=
GEMINI_API_KEY=

# Storage & Database Path (for local SQLite & audio files when not using Netlify Blobs)
SQLITE_DB_PATH=./data/memoir.db
AUDIO_STORAGE_DIR=./data/uploads
